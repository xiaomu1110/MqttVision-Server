@page "/ops"
@implements IDisposable
@inject OpsStateService OpsState
@inject NavigationManager Navigation

<PageTitle>MqttVision 运维平台</PageTitle>

<main class="ops-shell">
    <header class="ops-topbar">
        <div class="ops-topbar-left">
            <span class="ops-brand">MQTT<span class="ops-brand-dim">VISION</span></span>
            <span class="ops-sub">OPS · TERMINAL</span>
        </div>
        <div class="ops-topbar-right">
            <time class="ops-clock">@FormatClock(snapshot?.ServerTime)</time>
            <span class="ops-aggregate @AggregateClass()">@AggregateLabel()</span>
        </div>
    </header>
    @if (snapshot is null)
    {
        <section class="loading-panel">
            <div class="spinner"></div>
            <p>正在加载上位机运维数据...</p>
        </section>
    }
    else
    {
        <section class="health-grid">
            <HealthCard State="snapshot.MqttSubscriber" />
            <HealthCard State="snapshot.MqttPublisher" />
            <HealthCard State="snapshot.OcrService" />
            <HealthCard State="snapshot.YoloModel" />
        </section>

        <section class="kpi-grid">
            <KpiCard Label="今日任务" Value="@snapshot.Counters.TodayTasks.ToString()" Tone="blue" />
            <KpiCard Label="检测完成" Value="@snapshot.Counters.CompletedTasks.ToString()" Tone="green" />
            <KpiCard Label="疑似错接" Value="@snapshot.Counters.MismatchCount.ToString()" Tone="red" />
            <KpiCard Label="无法识别" Value="@snapshot.Counters.UnrecognizedCount.ToString()" Tone="yellow" />
            <KpiCard Label="队列中" Value="@snapshot.Counters.QueuedTasks.ToString()" Tone="blue" />
            <KpiCard Label="归档容量" Value="@snapshot.ArchiveSizeText" Tone="gray" />
        </section>

        <section class="content-grid">
            <article class="panel latest-panel">
                <div class="panel-title">
                    <div>
                        <h2>最新检测</h2>
                    </div>
                    <span class="status-pill @TaskStatusClass(LatestTask?.Status)">@((LatestTask?.Status) ?? "无任务")</span>
                </div>

                @if (LatestTask is null)
                {
                    <div class="empty-state">暂无检测任务。</div>
                }
                else
                {
                    <div class="latest-body">
                        <div class="visual-frame">
                            <div class="visual-crop">
                                <span class="corner tl"></span>
                                <span class="corner tr"></span>
                                <span class="corner bl"></span>
                                <span class="corner br"></span>
                                @if (!string.IsNullOrWhiteSpace(LatestTask.VisualSummaryUrl))
                                {
                                    <img class="visual-preview" src="@LatestTask.VisualSummaryUrl" alt="检测结果可视化" />
                                }
                                else
                                {
                                    <div class="visual-placeholder">等待生成结果可视化图片</div>
                                }
                            </div>
                        </div>

                        <aside class="latest-info-rail">
                            <div class="task-summary">
                                <div>
                                    <span>任务号</span>
                                    <strong>@LatestTask.TaskId</strong>
                                </div>
                                <div>
                                    <span>柜体</span>
                                    <strong>@LatestTask.CabinetId</strong>
                                </div>
                                <div>
                                    <span>设备</span>
                                    <strong>@LatestTask.DeviceId</strong>
                                </div>
                                <div>
                                    <span>更新时间</span>
                                    <strong>@FormatTime(LatestTask.UpdatedAt)</strong>
                                </div>
                            </div>

                            <div class="result-strip">
                                <span class="ok">一致 @LatestTask.MatchedCount</span>
                                <span class="bad">复查 @LatestTask.MismatchCount</span>
                                <span class="warn">无法识别 @LatestTask.UnrecognizedCount</span>
                            </div>

                            <div class="artifact-row">
                                @if (!string.IsNullOrWhiteSpace(LatestTask.ResultJsonUrl))
                                {
                                    <a href="@LatestTask.ResultJsonUrl" target="_blank">结果 JSON</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(LatestTask.ReportUrl))
                                {
                                    <a href="@LatestTask.ReportUrl" target="_blank">检测报告</a>
                                }
                            </div>
                        </aside>
                    </div>
                }
            </article>

            <article class="panel alert-panel">
                <div class="panel-title">
                    <div>
                        <h2>实时告警</h2>
                    </div>
                    <span class="count-badge">@snapshot.Alerts.Count</span>
                </div>

                @if (snapshot.Alerts.Count == 0)
                {
                    <div class="empty-state">当前无告警。</div>
                }
                else
                {
                    <div class="alert-list">
                        @foreach (var alert in snapshot.Alerts.Take(12))
                        {
                            <div class="alert-item @AlertClass(alert.Level)">
                                <div>
                                    <strong>@alert.Title</strong>
                                    <p>@alert.Message</p>
                                    @if (!string.IsNullOrWhiteSpace(alert.TaskId))
                                    {
                                        <small>@alert.TaskId</small>
                                    }
                                </div>
                                <time>@FormatTime(alert.CreatedAt)</time>
                            </div>
                        }
                    </div>
                }
            </article>
        </section>

        <section class="panel tasks-panel">
            <div class="panel-title">
                <div>
                    <h2>最近任务</h2>
                </div>
                <span class="count-badge">@snapshot.RecentTasks.Count</span>
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>任务号</th>
                            <th>设备</th>
                            <th>柜体</th>
                            <th>阶段</th>
                            <th class="num-col">端子/线号管</th>
                            <th class="num-col">一致</th>
                            <th class="num-col">复查</th>
                            <th class="num-col">无法识别</th>
                            <th>更新时间</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in snapshot.RecentTasks)
                        {
                            <tr>
                                <td class="mono">@task.TaskId</td>
                                <td>@task.DeviceId</td>
                                <td>@task.CabinetId</td>
                                <td><span class="status-pill @TaskStatusClass(task.Status)">@task.Stage</span></td>
                                <td class="num-col">@task.TerminalCount / @task.WireTagCount</td>
                                <td class="num-col ok-text">@task.MatchedCount</td>
                                <td class="num-col bad-text">@task.MismatchCount</td>
                                <td class="num-col warn-text">@task.UnrecognizedCount</td>
                                <td class="mono">@FormatTime(task.UpdatedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</main>

<style>
    :root {
        --bg: #0A0B0D;
        --surface: #111317;
        --surface-2: #1A1E24;
        --rule: #2A3038;
        --rule-strong: #3A424C;
        --text: #E8E6E1;
        --text-2: #8A8F96;
        --text-3: #565B63;
        --amber: #D4A24C;
        --green: #4ADE80;
        --red: #F87171;
        --yellow: #FBBF24;
        --blue: #60A5FA;
        --font-ui: "Inter", "Segoe UI", "Microsoft YaHei UI", system-ui, sans-serif;
        --font-mono: "JetBrains Mono", "Cascadia Mono", Consolas, ui-monospace, monospace;
        color-scheme: dark;
    }

    html, body {
        height: 100%;
        overflow: hidden;
    }

    body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-ui);
    }

    h1, h2, p {
        margin: 0;
    }

    /* 顶部状态栏:示波器签名扫描线 */
    .ops-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--rule);
        box-shadow: inset 0 -1px 0 rgba(212, 162, 76, 0.18);
    }

    .ops-topbar-left,
    .ops-topbar-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .ops-brand {
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--amber);
    }

    .ops-brand-dim {
        color: var(--text-2);
    }

    .ops-sub {
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-2);
    }

    .ops-clock {
        font-family: var(--font-mono);
        font-size: 14px;
        color: var(--text);
        font-variant-numeric: tabular-nums;
    }

    .ops-aggregate {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        padding: 3px 8px;
        border: 1px solid var(--text-3);
        border-radius: 2px;
        color: var(--text-2);
    }

    .agg-unknown {
        color: var(--text-3);
        border-color: var(--rule);
    }

    .agg-ok {
        color: var(--green);
        border-color: var(--green);
    }

    .agg-warn {
        color: var(--yellow);
        border-color: var(--yellow);
    }

    .agg-bad {
        color: var(--red);
        border-color: var(--red);
    }

    .ops-shell {
        box-sizing: border-box;
        height: 100vh;
        padding: calc(clamp(12px, 1.2vw, 24px) - 2px) clamp(12px, 1.2vw, 24px) clamp(12px, 1.2vw, 24px);
        display: grid;
        grid-template-rows: auto auto auto minmax(0, 1.18fr) minmax(164px, .42fr);
        gap: clamp(8px, .7vw, 14px);
        overflow: hidden;
        background-color: var(--bg);
        background-image: radial-gradient(circle, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
        background-size: 22px 22px;
    }

    .eyebrow {
        margin: 0 0 6px;
        color: var(--amber);
        font-size: 12px;
        text-transform: uppercase;
    }

    h1 {
        font-size: clamp(26px, 2.1vw, 40px);
        font-weight: 700;
        line-height: 1.05;
    }

    h2 {
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text);
    }

    .muted, .panel-title p {
        color: var(--text-2);
        margin-top: 4px;
        font-size: clamp(12px, .8vw, 15px);
    }

    /* 卡片:hairline 描边,无投影,4px 圆角 */
    .panel, .health-card, .kpi-card {
        border: 1px solid var(--rule);
        background: var(--surface);
        border-radius: 4px;
        box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.4);
    }

    .health-grid, .kpi-grid {
        display: grid;
        gap: clamp(8px, .65vw, 12px);
        min-height: 0;
    }

    .health-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .kpi-grid {
        grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .health-card, .kpi-card, .panel {
        padding: clamp(8px, .7vw, 14px);
        min-width: 0;
        min-height: 0;
        overflow: hidden;
    }

    .health-top, .kpi-label {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        color: var(--text-2);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .health-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .health-status {
        display: block;
        margin-top: clamp(5px, .45vw, 8px);
        font-size: clamp(15px, 1vw, 18px);
        color: var(--text);
    }

    .health-card p {
        color: var(--text-2);
        margin-top: 5px;
        font-size: clamp(11px, .72vw, 13px);
        overflow-wrap: anywhere;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .state-dot {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: var(--text-3);
        flex: 0 0 auto;
    }

    .state-online { background: var(--green); }
    .state-configured { background: var(--amber); }
    .state-disabled { background: var(--text-3); }
    .state-error { background: var(--red); }
    .state-unknown { background: var(--yellow); }

    .kpi-label {
        align-items: center;
    }

    .kpi-tick {
        display: inline-block;
        width: 2px;
        height: 10px;
        margin-right: 6px;
        background: var(--text-3);
        flex: 0 0 auto;
    }

    .kpi-blue .kpi-tick { background: var(--blue); }
    .kpi-green .kpi-tick { background: var(--green); }
    .kpi-red .kpi-tick { background: var(--red); }
    .kpi-yellow .kpi-tick { background: var(--yellow); }
    .kpi-gray .kpi-tick { background: var(--text-3); }

    .kpi-card strong {
        display: block;
        margin-top: 6px;
        font-family: var(--font-mono);
        font-size: 26px;
        font-weight: 500;
        line-height: 1.05;
        font-variant-numeric: tabular-nums;
        color: var(--text);
    }

    .kpi-blue strong { color: var(--blue); }
    .kpi-green strong { color: var(--green); }
    .kpi-red strong { color: var(--red); }
    .kpi-yellow strong { color: var(--yellow); }
    .kpi-gray strong { color: var(--text-2); font-size: 22px; }

    .content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(300px, .82fr);
        gap: clamp(8px, .7vw, 14px);
        min-height: 0;
    }

    .latest-panel, .alert-panel, .tasks-panel {
        display: flex;
        flex-direction: column;
    }

    .panel-title {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: start;
        margin-bottom: clamp(7px, .55vw, 11px);
        flex: 0 0 auto;
    }

    .status-pill, .count-badge {
        border-radius: 2px;
        padding: 3px 8px;
        background: var(--surface-2);
        color: var(--text-2);
        font-size: 11px;
        font-family: var(--font-mono);
        white-space: nowrap;
    }

    .status-pill.status-ok { color: var(--green); background: rgba(74, 222, 128, 0.10); }
    .status-pill.status-bad { color: var(--red); background: rgba(248, 113, 113, 0.10); }
    .status-pill.status-work { color: var(--blue); background: rgba(96, 165, 250, 0.10); }

    .latest-body {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(260px, .36fr);
        gap: clamp(7px, .55vw, 10px);
        flex: 1 1 auto;
        min-height: 0;
    }

    /* SCADA 取景框签名:四角 L 刻度 */
    .visual-frame {
        display: flex;
        min-width: 0;
        min-height: 0;
        position: relative;
    }

    .visual-crop {
        position: relative;
        flex: 1 1 auto;
        min-width: 0;
        min-height: 0;
        display: flex;
    }

    .corner {
        position: absolute;
        width: 12px;
        height: 12px;
        border-color: var(--rule-strong);
        border-style: solid;
        border-width: 0;
        z-index: 2;
        pointer-events: none;
    }

    .corner.tl { top: 0; left: 0; border-top-width: 1px; border-left-width: 1px; }
    .corner.tr { top: 0; right: 0; border-top-width: 1px; border-right-width: 1px; }
    .corner.bl { bottom: 0; left: 0; border-bottom-width: 1px; border-left-width: 1px; }
    .corner.br { bottom: 0; right: 0; border-bottom-width: 1px; border-right-width: 1px; }

    .latest-info-rail {
        display: grid;
        grid-template-rows: minmax(0, 1fr) auto auto;
        gap: clamp(7px, .55vw, 10px);
        min-width: 0;
        min-height: 0;
    }

    .task-summary {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(7px, .55vw, 10px);
        min-height: 0;
    }

    .task-summary div {
        background: var(--surface-2);
        border: 1px solid var(--rule);
        border-radius: 2px;
        padding: clamp(7px, .58vw, 10px);
        min-width: 0;
        min-height: 0;
    }

    .task-summary span {
        display: block;
        color: var(--text-2);
        font-size: 11px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .task-summary strong {
        display: block;
        overflow-wrap: anywhere;
        font-family: var(--font-mono);
        font-size: clamp(12px, .8vw, 15px);
        color: var(--text);
    }

    .visual-preview, .visual-placeholder {
        width: 100%;
        height: 100%;
        min-height: 0;
        object-fit: contain;
        border: 1px solid var(--rule);
        background: var(--bg);
        border-radius: 2px;
    }

    .visual-placeholder, .empty-state {
        display: grid;
        place-items: center;
        color: var(--text-3);
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .empty-state {
        color: var(--text-2);
        font-family: var(--font-ui);
        text-transform: none;
        letter-spacing: 0;
        font-size: 13px;
        padding: 24px;
    }

    .result-strip, .artifact-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        flex: 0 0 auto;
    }

    .result-strip span, .artifact-row a {
        border-radius: 2px;
        padding: 5px 8px;
        background: var(--surface-2);
        border: 1px solid var(--rule);
        text-decoration: none;
        font-size: 11px;
        font-family: var(--font-mono);
        transition: border-color 160ms, color 160ms;
    }

    .artifact-row a {
        color: var(--amber);
    }

    .artifact-row a:hover {
        border-color: var(--amber);
    }

    .result-strip span.ok { color: var(--green); }
    .result-strip span.bad { color: var(--red); }
    .result-strip span.warn { color: var(--yellow); }
    .ok-text { color: var(--green); }
    .bad-text { color: var(--red); }
    .warn-text { color: var(--yellow); }

    .alert-list {
        display: grid;
        gap: clamp(7px, .55vw, 10px);
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
    }

    .alert-item {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 10px;
        border: 1px solid var(--rule);
        border-left: 3px solid var(--amber);
        background: var(--surface-2);
        border-radius: 2px;
        padding: clamp(7px, .58vw, 10px);
    }

    .alert-warning { border-left-color: var(--yellow); }
    .alert-error { border-left-color: var(--red); }
    .alert-item p {
        color: var(--text-2);
        margin-top: 4px;
        line-height: 1.4;
        font-size: clamp(12px, .78vw, 14px);
    }

    .alert-item small, .alert-item time {
        color: var(--text-3);
        font-family: var(--font-mono);
        font-size: 11px;
    }

    .table-wrap {
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
    }

    .alert-list, .table-wrap {
        scrollbar-width: thin;
        scrollbar-color: var(--rule) transparent;
    }

    .alert-list::-webkit-scrollbar, .table-wrap::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .alert-list::-webkit-scrollbar-thumb, .table-wrap::-webkit-scrollbar-thumb {
        background: var(--rule);
        border-radius: 2px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 900px;
    }

    th, td {
        border-bottom: 1px solid var(--rule);
        padding: clamp(6px, .5vw, 10px) 8px;
        text-align: left;
        font-size: 12px;
    }

    th {
        color: var(--text-2);
        font-weight: 600;
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        background: var(--surface-2);
    }

    /* 计数值列:等宽 + 右对齐 */
    .num-col {
        font-family: var(--font-mono);
        text-align: right;
        font-variant-numeric: tabular-nums;
        color: var(--text);
    }

    .mono {
        font-family: var(--font-mono);
        color: var(--text);
    }

    .loading-panel {
        min-height: 70vh;
        display: grid;
        place-items: center;
        color: var(--text-2);
        gap: 14px;
    }

    .spinner {
        width: 36px;
        height: 36px;
        border: 2px solid var(--rule);
        border-top-color: var(--amber);
        border-radius: 999px;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    @@media (max-width: 1100px) {
        html, body {
            height: auto;
            overflow: auto;
        }

        .ops-shell {
            height: auto;
            min-height: 100vh;
            display: block;
            overflow: visible;
        }

        .ops-topbar {
            flex-wrap: wrap;
            gap: 8px;
        }

        .health-grid, .kpi-grid, .content-grid, .task-summary {
            grid-template-columns: 1fr 1fr;
        }

        .latest-body {
            grid-template-columns: 1fr;
        }

        .latest-info-rail {
            grid-template-rows: auto auto auto;
        }

        .health-grid, .kpi-grid, .content-grid {
            margin-bottom: 14px;
        }

        .visual-preview, .visual-placeholder {
            height: 340px;
        }

        .tasks-panel {
            min-height: 360px;
        }
    }

    @@media (max-width: 720px) {
        .ops-shell { padding: 14px; }
        .health-grid, .kpi-grid, .content-grid, .task-summary {
            grid-template-columns: 1fr;
        }
        h1 { font-size: 26px; }
        .visual-preview, .visual-placeholder { height: 260px; }
    }
</style>

@code {
    private readonly int refreshSeconds = 3;
    private readonly CancellationTokenSource refreshCancellation = new();
    private OpsDashboardSnapshot? snapshot;

    private OpsTaskRow? LatestTask => snapshot?.RecentTasks.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _ = RefreshLoopAsync();
    }

    private async Task RefreshLoopAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(refreshSeconds));
            while (await timer.WaitForNextTickAsync(refreshCancellation.Token))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        snapshot = await OpsState.GetSnapshotAsync(Navigation.BaseUri.TrimEnd('/'), refreshCancellation.Token);
    }

    private static string FormatTime(DateTimeOffset value) =>
        value.ToLocalTime().ToString("MM-dd HH:mm:ss");

    private static string StateClass(OpsComponentState state) =>
        state.Status.ToLowerInvariant() switch
        {
            "online" or "connected" => "state-online",
            "configured" => "state-configured",
            "disabled" => "state-disabled",
            "error" or "failed" or "offline" => "state-error",
            _ => "state-unknown"
        };

    private static string TaskStatusClass(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return string.Empty;
        }

        if (status.Contains("failed", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("error", StringComparison.OrdinalIgnoreCase))
        {
            return "status-bad";
        }

        if (status.Contains("complete", StringComparison.OrdinalIgnoreCase))
        {
            return "status-ok";
        }

        return "status-work";
    }

    private static string AlertClass(string level) =>
        level.ToLowerInvariant() switch
        {
            "warning" => "alert-warning",
            "error" or "critical" => "alert-error",
            _ => string.Empty
        };

    public void Dispose()
    {
        refreshCancellation.Cancel();
        refreshCancellation.Dispose();
    }

    private static string FormatClock(DateTimeOffset? serverTime) =>
        serverTime is null ? "--:--:--" : serverTime.Value.ToLocalTime().ToString("HH:mm:ss");

    private string AggregateClass()
    {
        // snapshot 未就绪时返回中性 agg-unknown,避免加载期聚合指示染色
        if (snapshot is null)
        {
            return "agg-unknown";
        }

        var states = new[]
        {
            snapshot.MqttSubscriber,
            snapshot.MqttPublisher,
            snapshot.OcrService,
            snapshot.YoloModel
        };

        foreach (var s in states)
        {
            if (s is null)
            {
                continue;
            }

            var status = s.Status.ToLowerInvariant();
            if (status is "error" or "failed" or "offline")
            {
                return "agg-bad";
            }
        }

        foreach (var s in states)
        {
            if (s is null)
            {
                continue;
            }

            var status = s.Status.ToLowerInvariant();
            if (status is "unknown" or "disabled")
            {
                return "agg-warn";
            }
        }

        return "agg-ok";
    }

    private string AggregateLabel()
    {
        var cls = AggregateClass();
        return cls switch
        {
            "agg-bad" => "FAULT",
            "agg-warn" => "DEGRADED",
            "agg-ok" => "ALL OK",
            _ => "--"
        };
    }
}
