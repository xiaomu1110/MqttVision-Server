<article class="kpi-card kpi-@Tone">
    <span class="kpi-label"><i class="kpi-tick"></i>@Label</span>
    <strong>@Value</strong>
</article>

@code {
    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string Tone { get; set; } = "gray";
}
