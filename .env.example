# Copy to .env and replace deployment-specific values. Do not commit production secrets.
ASPNETCORE_ENVIRONMENT=Production
SERVER_PORT=5080
PUBLIC_BASE_URL=http://172.16.10.113:5080

# 管理员后台密码（请在服务器 .env 中设置，不要提交真实密码）
MQTTVISION_ADMIN_PASSWORD=

# EMQX is already published on the host at 1883. The compose file maps this name to the host gateway.
MQTT_BROKER_HOST=host.docker.internal
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Set this to the PaddleOCR serving endpoint. For a sibling compose service use http://paddleocr:8080/ocr.
PADDLE_OCR_SERVICE_URL=http://host.docker.internal:8080/ocr

# Persistent runtime/CAD/configuration data. Use an absolute path on the server.
DATA_ROOT=/var/lib/mqttvision
