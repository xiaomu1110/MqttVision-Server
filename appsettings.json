{
  "MqttVision": {
    "PublicBaseUrl": "http://localhost:5080",
    "StorageRoot": "runtime",
    "MaxUploadBytes": 26214400,
    "Mqtt": {
      "BrokerHost": "localhost",
      "BrokerPort": 1883,
      "UserName": null,
      "Password": null,
      "ClientId": "mqttvision-server",
      "TaskSubmitTopic": "mqttvision/+/+/task/submit",
      "TaskProgressTopicTemplate": "mqttvision/{siteId}/{deviceId}/task/progress",
      "TaskResultTopicTemplate": "mqttvision/{siteId}/{deviceId}/task/result"
    },
    "JsonImport": {
      "MaxConcurrentImports": 3,
      "MaxFileBytes": 26214400,
      "AllowedExtensions": [ ".json" ]
    },
    "Processing": {
      "EnablePlaceholderPipeline": true,
      "YoloOnnxModelPath": "",
      "PaddleOcrModelDirectory": "",
      "PaddleOcrEnabled": false,
      "PaddleOcrDeploymentMode": "basic-serving",
      "PaddleOcrServiceUrl": "http://127.0.0.1:8080/ocr",
      "PaddleOcrVisualize": false,
      "PaddleOcrFileType": 1,
      "PaddleOcrUseDocOrientationClassify": true,
      "PaddleOcrUseDocUnwarping": false,
      "PaddleOcrUseTextlineOrientation": true,
      "PaddleOcrMinimumTextScore": 0.8,
      "PaddleOcrTimeoutSeconds": 30,
      "CabinetConfigurationRoot": "Configuration",
      "PairMaxDistancePixels": 160,
      "AmbiguousDistanceTolerancePixels": 15,
      "PairMaxHorizontalDistancePixels": 130,
      "PairMaxVerticalGapPixels": 120,
      "YoloInputSize": 1080,
      "ConfidenceThreshold": 0.8,
      "NmsThreshold": 0.4
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
